{
  "name": "mindpm",
  "version": "3.1.2",
  "description": "Project memory and a control plane for AI coding agents, over MCP.",
  "homepage": "https://umitkavala.github.io/mindpm/",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mindpm": "dist/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run check && npm run build",
    "build": "tsup src/index.ts --format esm --dts --clean && npm run build:ui",
    "build:ui": "cd ui && npm install && npm run build",
    "check": "tsc --noEmit && cd ui && npm run check",
    "dev": "tsup src/index.ts --format esm --watch",
    "dev:ui": "cd ui && npm run dev",
    "start": "node dist/index.js",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "gh release create v$(node -p \"require('./package.json').version\") --generate-notes --title \"v$(node -p \"require('./package.json').version\")\" --target main"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "llm",
    "memory",
    "persistent-memory",
    "project-memory",
    "sqlite",
    "project-management",
    "task-management",
    "kanban",
    "claude",
    "claude-code",
    "anthropic",
    "ai-memory",
    "context",
    "sessions",
    "decisions"
  ],
  "mcpName": "io.github.umitkavala/mindpm",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
